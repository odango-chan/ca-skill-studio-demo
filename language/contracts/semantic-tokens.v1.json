{
  "id": "connectionagent.skill.semantic-tokens",
  "schemaVersion": 1,
  "version": "0.1.0",
  "status": "frozen-v0.1",
  "authority": {
    "semantics": "ca-skills current authoring model and 5GC source baseline",
    "grammar": "ca-skill-compiler (target), legacy ca-skill-toolchain only for supported source constructs",
    "note": "This projection classifies existing source positions; it neither extends the authoring grammar nor asserts link/admission/runtime readiness."
  },
  "legend": {
    "tokenTypes": [
      {
        "id": "skillKeyword",
        "description": "Schema-defined Skill/YAML structural field"
      },
      {
        "id": "skillOperator",
        "description": "Executable Procedure node/step operator"
      },
      {
        "id": "skillProcedure",
        "description": "Declared or referenced Procedure identity"
      },
      {
        "id": "skillStep",
        "description": "Declared or referenced Procedure node/step identity"
      },
      {
        "id": "skillCapability",
        "description": "External governed Capability/Operation identity"
      },
      {
        "id": "skillTool",
        "description": "Skill-owned local Tool identity"
      },
      {
        "id": "skillPredicate",
        "description": "Predicate identity"
      },
      {
        "id": "skillObservation",
        "description": "Externally sourced Observation identifier"
      },
      {
        "id": "skillOutcome",
        "description": "Outcome or Predicate verdict in a declared route/expectation"
      },
      {
        "id": "skillDataType",
        "description": "Source-declared basic data type"
      },
      {
        "id": "skillSchema",
        "description": "Skill-owned Schema path or external schema reference"
      },
      {
        "id": "skillReference",
        "description": "Skill-owned script/reference file path"
      },
      {
        "id": "skillBinding",
        "description": "Explicit Procedure input/output/context binding"
      }
    ],
    "tokenModifiers": [
      {
        "id": "declaration",
        "description": "Source declaration"
      },
      {
        "id": "reference",
        "description": "Source reference, not necessarily resolved"
      },
      {
        "id": "imported",
        "description": "Imported read-only library declaration"
      }
    ]
  },
  "format": {
    "path": "Slash-separated YAML AST path from document root; * matches exactly one mapping key or array item.",
    "parts": [
      "key",
      "value"
    ],
    "exact": "Emitted only on a syntactically valid scalar with an exact single-line UTF-16 range.",
    "failure": "Invalid YAML or a position without matching structural rule retains ordinary TextMate highlighting.",
    "colors": "No theme colors are normative here."
  },
  "profiles": {
    "procedure": {
      "file": "assurance/procedure.yaml",
      "keywords": {
        "": [
          "procedures"
        ],
        "procedures/*": [
          "applicability",
          "inputs",
          "start",
          "nodes"
        ],
        "procedures/*/applicability": [
          "predicates"
        ],
        "procedures/*/inputs/*": [
          "type",
          "from",
          "required",
          "value"
        ],
        "procedures/*/nodes/*": [
          "call",
          "verify",
          "tool",
          "script",
          "reconcile",
          "procedure",
          "terminal",
          "with",
          "on",
          "preconditions",
          "postconditions"
        ],
        "procedures/*/nodes/*/preconditions": [
          "steps",
          "on"
        ],
        "procedures/*/nodes/*/preconditions/steps/*": [
          "name",
          "call",
          "verify",
          "tool",
          "script",
          "procedure",
          "with"
        ],
        "procedures/*/nodes/*/postconditions": [
          "steps",
          "on"
        ],
        "procedures/*/nodes/*/postconditions/steps/*": [
          "name",
          "call",
          "verify",
          "tool",
          "script",
          "procedure",
          "with"
        ]
      },
      "rules": [
