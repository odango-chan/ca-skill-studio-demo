    "contract": {
      "file": "assurance/contract.yaml",
      "keywords": {
        "": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "metadata": [
          "name"
        ],
        "spec": [
          "skillType",
          "goal",
          "entryProcedure",
          "inputs",
          "context",
          "allowedResources",
          "preconditions",
          "postconditions",
          "planning",
          "failureSemantics"
        ],
        "spec/inputs": [
          "requestSchema"
        ],
        "spec/context": [
          "requiredFacts"
        ],
        "spec/allowedResources": [
          "capabilities",
          "localTools"
        ],
        "spec/preconditions/*": [
          "predicate",
          "expect"
        ],
        "spec/postconditions/*": [
          "predicate",
          "expect"
        ],
        "spec/planning": [
          "maxActions",
          "allowDynamicProcedure"
        ],
        "spec/failureSemantics": [
          "outcomeUnknown"
        ],
        "spec/failureSemantics/outcomeUnknown": [
          "requireReconcile"
        ]
      },
      "rules": [
        {
          "path": "spec/entryProcedure",
          "part": "value",
          "type": "skillProcedure",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/inputs/requestSchema",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/allowedResources/capabilities/*",
          "part": "value",
          "type": "skillCapability",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/allowedResources/localTools/*",
          "part": "value",
          "type": "skillTool",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/preconditions/*/predicate",
          "part": "value",
          "type": "skillPredicate",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/preconditions/*/expect",
          "part": "value",
          "type": "skillOutcome"
        },
        {
          "path": "spec/postconditions/*/predicate",
          "part": "value",
          "type": "skillPredicate",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "spec/postconditions/*/expect",
          "part": "value",
          "type": "skillOutcome"
        }
      ]
    },
    "predicates": {
      "file": "assurance/predicates.yaml",
      "keywords": {
        "": [
          "apiVersion",
          "kind",
          "metadata",
          "predicates"
        ],
        "metadata": [
          "skill"
        ],
        "predicates/*": [
          "observations",
          "evaluator"
        ],
        "predicates/*/observations/*": [
          "ref",
          "scope",
          "freshness",
          "absencePolicy"
        ],
        "predicates/*/evaluator": [
          "type",
          "expression",
          "script",
          "with"
        ]
      },
      "rules": [
        {
          "path": "predicates/*",
          "part": "key",
          "type": "skillPredicate",
          "modifiers": [
            "declaration"
          ]
        },
        {
          "path": "predicates/*/observations/*/ref",
          "part": "value",
          "type": "skillObservation",
          "modifiers": [
            "reference"
          ]
        }
      ]
    },
    "schema": {
      "file": "schemas/*.schema.yaml",
      "keywords": {
        "": [
          "$schema",
          "$id",
          "title",
          "description",
          "type",
          "properties",
          "required",
          "items",
          "$defs",
          "definitions",
          "$ref",
          "enum",
          "additionalProperties"
        ],
        "properties/*": [
          "$ref",
          "type",
          "title",
          "description",
          "items",
          "properties",
          "required",
          "enum",
          "additionalProperties"
        ],
        "$defs/*": [
          "$ref",
          "type",
          "title",
          "description",
          "items",
          "properties",
          "required",
          "enum",
          "additionalProperties"
        ],
        "definitions/*": [
          "$ref",
          "type",
          "title",
          "description",
          "items",
          "properties",
          "required",
          "enum",
          "additionalProperties"
        ],
        "items": [
          "$ref",
          "type",
          "title",
          "description",
          "items",
          "properties",
          "required",
          "enum",
          "additionalProperties"
        ]
      },
      "rules": [
        {
          "path": "type",
          "part": "value",
          "type": "skillDataType"
        },
        {
          "path": "$ref",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "properties/*/type",
          "part": "value",
          "type": "skillDataType"
        },
        {
          "path": "properties/*/$ref",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "$defs/*/type",
          "part": "value",
          "type": "skillDataType"
        },
        {
          "path": "$defs/*/$ref",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "definitions/*/type",
          "part": "value",
          "type": "skillDataType"
        },
        {
          "path": "definitions/*/$ref",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "items/type",
          "part": "value",
          "type": "skillDataType"
        },
        {
          "path": "items/$ref",
          "part": "value",
          "type": "skillSchema",
          "modifiers": [
            "reference"
          ]
        }
      ]
    },
    "importedToolCatalog": {
      "file": "lib/tools/*.tool.yaml",
      "keywords": {
        "": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ],
        "spec": [
          "contracts",
          "operations"
        ],
        "spec/contracts/*": [
          "operation",
          "adapter",
          "effect",
          "inputSchema",
          "outputSchema",
          "reconcileOutputSchema",
          "description"
        ],
        "spec/operations/*": [
          "operation",
          "adapter",
          "effect",
          "inputSchema",
          "outputSchema",
          "reconcileOutputSchema",
          "description"
        ]
      },
      "rules": [
        {
          "path": "spec/contracts/*/operation",
          "part": "value",
          "type": "skillCapability",
          "modifiers": [
            "declaration",
            "imported"
          ]
        },
        {
          "path": "spec/operations/*/operation",
          "part": "value",
          "type": "skillCapability",
          "modifiers": [
            "declaration",
            "imported"
          ]
        }
      ]
    }
  }
}
