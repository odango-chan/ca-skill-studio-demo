          "path": "procedures/*",
          "part": "key",
          "type": "skillProcedure",
          "modifiers": [
            "declaration"
          ]
        },
        {
          "path": "procedures/*/nodes/*",
          "part": "key",
          "type": "skillStep",
          "modifiers": [
            "declaration"
          ]
        },
        {
          "path": "procedures/*/start",
          "part": "value",
          "type": "skillStep",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "procedures/*/applicability/predicates/*",
          "part": "key",
          "type": "skillPredicate",
          "modifiers": [
            "reference"
          ]
        },
        {
          "path": "procedures/*/applicability/predicates/*",
          "part": "value",
          "type": "skillOutcome"
        },
        {
          "path": "procedures/*/nodes/*/call",
