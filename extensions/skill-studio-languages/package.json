{
  "name": "skill-studio-languages",
  "displayName": "SKILL Studio YAML & Python Syntax",
  "version": "0.0.1",
  "publisher": "odango-chan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "configuration": "./upstream/yaml/language-configuration.json"
      },
      {
        "id": "python",
        "aliases": [
          "Python",
          "python"
        ],
        "extensions": [
          ".py",
          ".pyw",
          ".pyi"
        ],
        "configuration": "./upstream/python/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yaml",
        "scopeName": "source.yaml",
        "path": "./upstream/yaml/syntaxes/yaml.tmLanguage.json",
        "unbalancedBracketScopes": [
          "invalid.illegal",
          "meta.scalar.yaml"
        ]
      },
      {
        "scopeName": "source.yaml.1.3",
        "path": "./upstream/yaml/syntaxes/yaml-1.3.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.2",
        "path": "./upstream/yaml/syntaxes/yaml-1.2.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.1",
        "path": "./upstream/yaml/syntaxes/yaml-1.1.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.0",
        "path": "./upstream/yaml/syntaxes/yaml-1.0.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.embedded",
        "path": "./upstream/yaml/syntaxes/yaml-embedded.tmLanguage.json"
      },
      {
        "language": "python",
        "scopeName": "source.python",
        "path": "./upstream/python/syntaxes/MagicPython.tmLanguage.json"
      },
      {
        "scopeName": "source.regexp.python",
        "path": "./upstream/python/syntaxes/MagicRegExp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[yaml]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[python]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "skillKeyword",
        "superType": "keyword",
        "description": "Skill Language structural field"
      },
      {
        "id": "skillOperator",
        "superType": "keyword",
        "description": "Procedure node or step operator"
      },
      {
        "id": "skillProcedure",
        "superType": "type",
        "description": "Declared or referenced Procedure identity"
      },
      {
        "id": "skillStep",
        "superType": "type",
        "description": "Declared or referenced Procedure node/step identity"
      },
      {
        "id": "skillCapability",
        "superType": "variable",
        "description": "Skill resource-grant identity"
      },
      {
        "id": "skillPredicate",
        "superType": "type",
        "description": "Predicate identity"
      },
      {
        "id": "skillObservation",
        "superType": "variable",
        "description": "Externally sourced Observation identifier"
      },
      {
        "id": "skillOutcome",
        "superType": "enumMember",
        "description": "Outcome or Predicate verdict"
      },
      {
        "id": "skillDataType",
        "superType": "type",
        "description": "Source-declared basic data type"
      },
      {
        "id": "skillSchema",
        "superType": "variable",
        "description": "Skill-owned Schema path or external Schema reference"
      },
      {
        "id": "skillReference",
        "superType": "variable",
        "description": "Skill-owned Script or Reference path"
      },
      {
        "id": "skillBinding",
        "superType": "variable",
        "description": "Explicit Procedure binding"
      },
      {
        "id": "skillOperation",
        "superType": "function",
        "description": "Exact callable Operation identity from an imported ToolCatalog"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "reference",
        "description": "Source reference, not necessarily resolved"
      },
      {
        "id": "imported",
        "description": "Imported read-only Library declaration"
      }
    ]
  }
}
