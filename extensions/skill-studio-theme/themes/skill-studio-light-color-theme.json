  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8FA0B4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7B5BA7"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#16846F"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#AD6517"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#286CA8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#317DC0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#20314A"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#0C8E7B"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#75889D"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#0B7165",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#20314A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#287D9B",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#697E97",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.list"
      ],
      "settings": {
        "foreground": "#0C8E7B"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#C65D5D"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#317DC0",
    "type": "#317DC0",
    "class": "#317DC0",
    "function": "#286CA8",
    "method": "#286CA8",
    "parameter": "#596F84",
    "property": "#317DC0",
    "enumMember": "#0C8E7B",
    "keyword": "#7B5BA7",
    "string": "#16846F",
    "number": "#AD6517",
    "comment": {
      "foreground": "#8FA0B4",
      "italic": true
    },
    "skillKeyword": "#0C8E7B",
    "skillOperator": "#7B5BA7",
    "skillProcedure": "#AD6517",
    "skillStep": "#AD6517",
    "skillCapability": "#278A98",
    "skillPredicate": "#317DC0",
    "skillObservation": "#287D9B",
    "skillOutcome": "#AD6517",
    "skillDataType": "#317DC0",
    "skillSchema": "#287D9B",
    "skillReference": "#16846F",
    "skillBinding": "#697E97",
    "skillOperation": "#286CA8"
  }
}
