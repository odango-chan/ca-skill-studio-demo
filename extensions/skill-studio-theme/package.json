{
  "name": "skill-studio-theme",
  "displayName": "SKILL Studio Theme",
  "description": "A shared light workbench, editor syntax and file icon theme for SKILL Studio in VS Code and Eclipse Theia.",
  "version": "0.1.0",
  "publisher": "odango-chan",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "skill-studio",
    "theme",
    "light-theme",
    "file-icons"
  ],
  "contributes": {
    "themes": [
      {
        "label": "SKILL Studio Light",
