{
  "name": "ca-skill-studio-ide-spike",
  "displayName": "SKILL Studio IDE Host",
  "description": "Source-first SKILL authoring, Package Explorer and native editor integration for VS Code-compatible desktop/web hosts, including Theia.",
  "version": "0.0.1",
  "publisher": "odango-chan",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.88.0"
  },
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onCommand:skillStudio.openProcedure",
    "onCommand:skillStudio.loadExample",
    "onCommand:skillStudio.newProject",
    "onCommand:skillStudio.openProject",
    "onCommand:skillStudio.openLanguageSpec",
    "onCommand:skillStudio.openAuthoringGuide",
    "onStartupFinished",
    "onCommand:skillStudio.internal.runNativeAgent",
    "onCommand:skillStudio.auditPackage",
    "onCommand:skillStudio.runDiagnosticTests",
    "onCommand:skillStudio.runRouteScenarios",
    "onCommand:skillStudio.exportPackageZip",
    "onCommand:skillStudio.refreshInspection",
    "onCommand:skillStudio.restartLanguageService",
    "onCommand:skillStudio.openContract",
    "onCommand:skillStudio.openPredicates",
    "onCommand:skillStudio.openSchema",
    "onCommand:skillStudio.refreshPackages",
    "onView:skillStudio.packages",
    "onView:skillStudio.outline",
    "onView:skillStudio.problems",
    "onView:skillStudio.inspection",
    "onCommand:skillStudio.selectProjectRoot",
    "onCommand:skillStudio.addDependency",
    "onCommand:skillStudio.refreshDependencies",
    "onCommand:skillStudio.refreshDependency",
    "onCommand:skillStudio.updateDependencyLock",
    "onCommand:skillStudio.removeDependency",
    "onCommand:skillStudio.inspectDependencyContract",
    "onCommand:skillStudio.openInterfaceExport",
    "onCommand:skillStudio.showWelcome",
    "onCommand:skillStudio.checkSkill",
    "onCommand:skillStudio.buildSkill",
    "onCommand:skillStudio.inspectCompilerDependencies",
    "onView:skillStudio.preview",
    "onCommand:skillStudio.showActivationDiagnostics",
    "onCommand:skillStudio.openAiAuthoring",
    "onCommand:skillStudio.openConsole",
    "onCommand:skillStudio.setAiGatewayToken"
  ],
  "contributes": {
    "colors": [
      {
        "id": "skillStudio.markdownHeading",
        "description": "SKILL Studio Markdown heading accent, following the active VS Code/Theia color theme.",
        "defaults": {
          "light": "#0c8e7b",
          "dark": "#83d9c4",
          "highContrastLight": "#075f55",
          "highContrast": "#a8f0df"
        }
      }
    ],
    "commands": [
      {
        "command": "skillStudio.showWelcome",
        "title": "%project.welcome.title%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.showActivationDiagnostics",
        "title": "%command.showActivationDiagnostics%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.newProject",
        "title": "%project.new%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openProject",
        "title": "%project.open%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openLanguageSpec",
        "title": "%help.spec%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openAuthoringGuide",
        "title": "%help.guide%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.refreshPackages",
        "title": "%command.refreshPackages%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openSchema",
        "title": "%command.openSchema%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openProcedure",
        "title": "%command.openProcedure%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.loadExample",
        "title": "%project.example%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.auditPackage",
        "title": "%command.auditPackage%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.runDiagnosticTests",
        "title": "Run Offline Diagnostic Tests (No Runtime)",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.runRouteScenarios",
        "title": "Replay Procedure Route Scenarios (No Runtime)",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.exportPackageZip",
        "title": "%command.exportPackageZip%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.refreshInspection",
        "title": "%command.refreshInspection%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.restartLanguageService",
        "title": "%command.restartLanguageService%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openPredicates",
        "title": "%command.openPredicates%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openContract",
        "title": "%command.openContract%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.selectProjectRoot",
        "title": "%command.selectProjectRoot%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.addDependency",
        "title": "%command.addDependency%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.refreshDependencies",
        "title": "%command.refreshDependencies%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.refreshDependency",
        "title": "%command.refreshDependency%"
      },
      {
        "command": "skillStudio.updateDependencyLock",
        "title": "%command.updateDependencyLock%"
      },
      {
        "command": "skillStudio.removeDependency",
        "title": "%command.removeDependency%"
      },
      {
        "command": "skillStudio.inspectDependencyContract",
        "title": "%command.inspectDependencyContract%"
      },
      {
        "command": "skillStudio.openInterfaceExport",
        "title": "Open Immutable Interface Package Export",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.checkSkill",
        "title": "%command.checkSkill%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.buildSkill",
        "title": "%command.buildSkill%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.inspectCompilerDependencies",
        "title": "%command.inspectCompilerDependencies%",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openAiAuthoring",
        "title": "AI Workbench",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.openConsole",
        "title": "Console",
        "category": "SKILL Studio"
      },
      {
        "command": "skillStudio.setAiGatewayToken",
        "title": "%ai.gateway.token%",
        "category": "SKILL Studio"
      }
    ],
    "languages": [
      {
        "id": "markdown",
        "aliases": [
          "Markdown",
          "markdown"
        ],
        "extensions": [
          ".md",
          ".markdown"
        ],
        "configuration": "./dist/grammars/markdown/language-configuration.json"
      },
      {
        "id": "json",
        "aliases": [
          "JSON",
          "json"
        ],
        "extensions": [
          ".json"
        ]
      },
      {
        "id": "yaml",
        "aliases": [
          "YAML",
          "yaml"
        ],
        "extensions": [
          ".yaml",
          ".yml"
        ],
        "configuration": "./dist/grammars/yaml/language-configuration.json"
      },
      {
        "id": "python",
        "aliases": [
          "Python",
          "python"
        ],
        "extensions": [
          ".py",
          ".pyw",
          ".pyi"
        ],
        "configuration": "./dist/grammars/python/language-configuration.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "skillStudio.openAiAuthoring",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "skillStudio.openSchema",
          "when": "resourceFilename =~ /\\.schema\\.ya?ml$/",
          "group": "navigation"
        },
        {
          "command": "skillStudio.openContract",
          "when": "resourceFilename == contract.yaml",
          "group": "navigation"
        },
        {
          "command": "skillStudio.openPredicates",
          "when": "resourceFilename == predicates.yaml",
          "group": "navigation"
        },
        {
          "command": "skillStudio.openProcedure",
          "when": "resourceFilename == procedure.yaml",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "skillStudio.refreshPackages",
          "when": "view == skillStudio.packages",
          "group": "navigation"
        },
        {
          "command": "skillStudio.auditPackage",
          "when": "view == skillStudio.inspection || view == skillStudio.problems",
          "group": "navigation"
        },
        {
          "command": "skillStudio.refreshInspection",
          "when": "view == skillStudio.inspection",
          "group": "navigation"
        },
        {
          "command": "skillStudio.addDependency",
          "when": "view == skillStudio.packages",
          "group": "navigation@3"
        },
        {
          "command": "skillStudio.checkSkill",
          "when": "view == skillStudio.packages",
          "group": "navigation@6"
        },
        {
          "command": "skillStudio.buildSkill",
          "when": "view == skillStudio.packages",
          "group": "navigation@7"
        },
        {
          "command": "skillStudio.showWelcome",
          "when": "view == skillStudio.packages",
          "group": "navigation@1"
        },
        {
          "command": "skillStudio.showActivationDiagnostics",
          "when": "view == skillStudio.packages",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "skillStudio.inspectDependencyContract",
          "when": "view == skillStudio.packages && viewItem == skillStudio.dependency",
          "group": "1_inspect"
        },
        {
          "command": "skillStudio.refreshDependency",
          "when": "view == skillStudio.packages && viewItem == skillStudio.dependency",
          "group": "2_refresh"
        },
        {
          "command": "skillStudio.updateDependencyLock",
          "when": "view == skillStudio.packages && viewItem == skillStudio.dependency",
          "group": "3_update"
        },
        {
          "command": "skillStudio.removeDependency",
          "when": "view == skillStudio.packages && viewItem == skillStudio.dependency",
          "group": "4_remove"
        },
        {
          "command": "skillStudio.checkSkill",
          "when": "view == skillStudio.packages && viewItem == skillStudio.package",
          "group": "5_compiler"
        },
        {
          "command": "skillStudio.buildSkill",
          "when": "view == skillStudio.packages && viewItem == skillStudio.package",
          "group": "6_compiler"
        },
        {
          "command": "skillStudio.inspectCompilerDependencies",
          "when": "view == skillStudio.packages && viewItem == skillStudio.package",
          "group": "7_compiler"
        }
      ],
      "commandPalette": [
        {
          "command": "skillStudio.refreshDependency",
          "when": "false"
        },
        {
          "command": "skillStudio.updateDependencyLock",
          "when": "false"
        },
        {
          "command": "skillStudio.inspectDependencyContract",
          "when": "false"
        },
        {
          "command": "skillStudio.removeDependency",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workbench.explorer.fileView",
        "contents": "%project.welcome%",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "skillStudioPreview",
          "title": "Preview",
          "icon": "icons/preview.svg"
        },
        {
          "id": "skillStudioInspector",
          "title": "Inspector",
          "icon": "icons/skill-studio.svg"
        }
      ]
    },
    "views": {
      "skillStudioPreview": [
        {
          "id": "skillStudio.preview",
          "name": "Preview",
          "type": "webview",
          "visibility": "visible"
        }
      ],
      "skillStudioInspector": [
        {
          "id": "skillStudio.inspection",
          "name": "Inspector"
        }
      ],
      "explorer": [
        {
          "id": "skillStudio.packages",
          "name": "Package Explorer",
          "visibility": "visible"
        },
        {
          "id": "skillStudio.outline",
          "name": "Procedure Outline"
        },
        {
          "id": "skillStudio.problems",
          "name": "Problems"
        }
      ]
    },
    "configuration": {
      "id": "connectionAgent.skillStudio",
      "title": "Skill Studio",
      "type": "object",
      "properties": {
        "connectionAgent.skillStudio.skillsRoot": {
          "type": "string",
          "enum": [
            "skills"
          ],
          "default": "skills",
          "scope": "resource",
          "markdownDescription": "Project Skill source root. Current Studio authoring and the integrated CA Skill Compiler v2.0.2 target CA-SL v1alpha5 Skills under skills/<skill-name>/."
        },
        "connectionAgent.skillStudio.dependencies": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "items": {
            "type": "object"
          },
          "markdownDescription": "Studio-managed dependency declarations for tool-catalog, schema-bundle and interface-package. Add, refresh and update locks through Package Explorer. Snapshot verification and Schema hints do not imply Compiler linking or Owner / Runtime authorization."
        },
        "connectionAgent.skillStudio.dependencyLock": {
          "type": "object",
          "default": {
            "version": "skillc.lock/v0.1",
            "entries": []
          },
          "scope": "resource",
          "markdownDescription": "Studio-owned skillc.lock/v0.1 provenance lock binding dependency declarations to immutable snapshots. This is not the Compiler v2.1.0 interface-dependency-lock/v1alpha1. The v2.1.0 Development Build request derives its separate lock from exact formal Contract roots and transitive Interface Package closure. Lock verification does not imply Owner / Runtime authorization."
        },
        "connectionAgent.skillStudio.defaultBuildTarget": {
          "type": "string",
          "enum": [
            "all"
          ],
          "default": "all",
          "scope": "application",
          "markdownDescription": "Default target selection for the integrated CA Skill Compiler v2.0.2 adapter. Compiler v2.1.0 Development Build / Verify is a separate API family and is not yet integrated into Studio main."
        },
        "connectionAgent.skillStudio.ai.gatewayUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787/opencode-go/openai",
          "scope": "application",
          "markdownDescription": "Defaults to a local-only Go ai-gateway at http://127.0.0.1:8787/opencode-go/openai. Start the Gateway yourself and approve your browser's local network access; Studio does not start a service or send a model request automatically. Customize the URL here for another route. HTTP is allowed only for loopback; remote Gateways require HTTPS.",
          "description": "Local AI Gateway by default; customize this URL to use your own Gateway."
        },
        "connectionAgent.skillStudio.ai.model": {
          "type": "string",
          "default": "deepseek-v4.1-flash",
          "scope": "application",
          "markdownDescription": "Default model: deepseek-v4.1-flash. Use the AI Authoring Editor Tab's Select Model action to browse the configured Gateway catalog, or enter a custom Model ID here. Selection is saved in application settings."
        }
      }
    },
    "grammars": [
      {
        "language": "markdown",
        "scopeName": "text.html.markdown",
        "path": "./dist/grammars/markdown/syntaxes/markdown.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "source.js": "javascript",
          "source.css": "css",
          "meta.embedded.block.frontmatter": "yaml",
          "meta.embedded.block.css": "css",
          "meta.embedded.block.ini": "ini",
          "meta.embedded.block.java": "java",
          "meta.embedded.block.lua": "lua",
          "meta.embedded.block.makefile": "makefile",
          "meta.embedded.block.perl": "perl",
          "meta.embedded.block.r": "r",
          "meta.embedded.block.ruby": "ruby",
          "meta.embedded.block.php": "php",
          "meta.embedded.block.sql": "sql",
          "meta.embedded.block.vs_net": "vs_net",
          "meta.embedded.block.xml": "xml",
          "meta.embedded.block.xsl": "xsl",
          "meta.embedded.block.yaml": "yaml",
          "meta.embedded.block.dosbatch": "dosbatch",
          "meta.embedded.block.clojure": "clojure",
          "meta.embedded.block.coffee": "coffee",
          "meta.embedded.block.c": "c",
          "meta.embedded.block.cpp": "cpp",
          "meta.embedded.block.diff": "diff",
          "meta.embedded.block.dockerfile": "dockerfile",
          "meta.embedded.block.go": "go",
          "meta.embedded.block.groovy": "groovy",
          "meta.embedded.block.pug": "jade",
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.block.json": "json",
          "meta.embedded.block.jsonc": "jsonc",
          "meta.embedded.block.latex": "latex",
          "meta.embedded.block.less": "less",
          "meta.embedded.block.objc": "objc",
          "meta.embedded.block.scss": "scss",
          "meta.embedded.block.perl6": "perl6",
          "meta.embedded.block.powershell": "powershell",
          "meta.embedded.block.python": "python",
          "meta.embedded.block.rust": "rust",
          "meta.embedded.block.scala": "scala",
          "meta.embedded.block.shellscript": "shellscript",
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.block.typescriptreact": "typescriptreact",
          "meta.embedded.block.csharp": "csharp",
          "meta.embedded.block.fsharp": "fsharp"
        },
        "unbalancedBracketScopes": [
          "markup.underline.link.markdown",
          "punctuation.definition.list.begin.markdown"
        ]
      },
      {
        "language": "yaml",
        "scopeName": "source.yaml",
        "path": "./dist/grammars/yaml/syntaxes/yaml.tmLanguage.json",
        "unbalancedBracketScopes": [
          "invalid.illegal",
          "meta.scalar.yaml"
        ]
      },
      {
        "scopeName": "source.yaml.1.3",
        "path": "./dist/grammars/yaml/syntaxes/yaml-1.3.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.2",
        "path": "./dist/grammars/yaml/syntaxes/yaml-1.2.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.1",
        "path": "./dist/grammars/yaml/syntaxes/yaml-1.1.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.1.0",
        "path": "./dist/grammars/yaml/syntaxes/yaml-1.0.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.embedded",
        "path": "./dist/grammars/yaml/syntaxes/yaml-embedded.tmLanguage.json"
      },
      {
        "language": "python",
        "scopeName": "source.python",
        "path": "./dist/grammars/python/syntaxes/MagicPython.tmLanguage.json"
      },
      {
        "scopeName": "source.regexp.python",
        "path": "./dist/grammars/python/syntaxes/MagicRegExp.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[yaml]": {
        "editor.semanticHighlighting.enabled": true
      },
      "[python]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "skillKeyword",
        "superType": "keyword",
        "description": "Skill Language structural field"
      },
      {
        "id": "skillOperator",
        "superType": "keyword",
        "description": "Procedure node or step operator"
      },
      {
        "id": "skillStep",
        "superType": "type",
        "description": "Declared or referenced Procedure node/step identity"
      },
      {
        "id": "skillCapability",
        "superType": "variable",
        "description": "Skill resource-grant identity"
      },
      {
        "id": "skillPredicate",
        "superType": "type",
        "description": "Predicate identity"
      },
      {
        "id": "skillObservation",
        "superType": "variable",
        "description": "Externally sourced Observation identifier"
      },
      {
        "id": "skillOutcome",
        "superType": "enumMember",
        "description": "Outcome or Predicate verdict"
      },
      {
        "id": "skillDataType",
        "superType": "type",
        "description": "Source-declared basic data type"
      },
      {
        "id": "skillSchema",
        "superType": "variable",
        "description": "Skill-owned Schema path or external Schema reference"
      },
      {
        "id": "skillReference",
        "superType": "variable",
        "description": "Skill-owned Script or Reference path"
      },
      {
        "id": "skillBinding",
        "superType": "variable",
        "description": "Explicit Procedure binding"
      },
      {
        "id": "skillOperation",
        "superType": "function",
        "description": "Exact callable Operation identity from an imported ToolCatalog"
      },
      {
        "id": "skillWait",
        "superType": "keyword",
        "description": "CA-SL v1alpha5 Node-entry Event Wait control; not a business stage"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "reference",
        "description": "Source reference, not necessarily resolved"
      },
      {
        "id": "imported",
        "description": "Imported read-only Library declaration"
      }
    ]
  },
  "scripts": {
    "build": "node ../scripts/build-ide-spike.mjs",
    "package": "npm run build && npx --yes @vscode/vsce package --no-dependencies"
  },
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "samples/**",
    "icons/**"
  ],
  "browser": "./dist/extension-web.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/odango-chan/ca-skill-studio-demo.git"
  }
}
