{
  "private": true,
  "name": "skill-studio-theia-browser-host-spike",
  "version": "0.0.1",
  "license": "UNLICENSED",
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "SKILL Studio · Theia Browser Host Trial",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "workbench.list.openMode": "singleClick",
          "editor.enablePreview": true,
          "workbench.editorAssociations": {
            "procedure.yaml": "skillStudio.procedurePreview",
            "contract.yaml": "skillStudio.contractPreview",
            "predicates.yaml": "skillStudio.predicatePreview",
            "*.schema.yaml": "skillStudio.schemaPreview"
          },
          "workbench.colorTheme": "SKILL Studio Light",
          "workbench.iconTheme": "skill-studio-file-icons",
          "editor.semanticHighlighting.enabled": true,
          "markdown.preview.scrollPreviewWithEditor": true,
          "markdown.preview.scrollEditorWithPreview": true,
          "markdown.preview.markEditorSelection": true,
          "markdown.preview.openMarkdownLinks": "inPreview"
        },
        "warnOnPotentiallyInsecureHostPattern": false
      }
    },
    "backend": {
      "config": {
        "warnOnPotentiallyInsecureHostPattern": false
      }
    }
  },
  "theiaPluginsDir": "../theia-online/plugins",
  "dependencies": {
    "@theia/core": "1.76.0",
    "@theia/editor": "1.76.0",
    "@theia/filesystem": "1.76.0",
    "@theia/navigator": "1.76.0",
    "@theia/workspace": "1.76.0",
    "@theia/monaco": "1.76.0",
    "@theia/preferences": "1.76.0",
    "@theia/keymaps": "1.76.0",
    "@theia/markers": "1.76.0",
    "@theia/messages": "1.76.0",
    "@theia/plugin-ext": "1.76.0",
    "@theia/plugin-ext-vscode": "1.76.0",
    "@theia/bulk-edit": "1.76.0",
    "@theia/file-search": "1.76.0",
    "@theia/search-in-workspace": "1.76.0",
    "@theia/outline-view": "1.76.0",
    "@theia/variable-resolver": "1.76.0",
    "@theia/userstorage": "1.76.0"
  },
  "devDependencies": {
    "@theia/cli": "1.76.0"
  },
  "theiaPlugins": {
    "vscode.markdown-language-features": "https://open-vsx.org/api/vscode/markdown-language-features/1.119.0/file/vscode.markdown-language-features-1.119.0.vsix"
  },
  "scripts": {
    "build": "theia build --mode production",
    "download:plugins": "theia download:plugins",
    "start": "theia start --hostname 127.0.0.1 --port 3000"
  }
}
